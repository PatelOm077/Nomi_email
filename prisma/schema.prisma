// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ShopSettings {
  shop           String   @id
  sendingEnabled Boolean  @default(false)
  // Separate, narrower opt-in for the two event types that will always
  // duplicate a Shopify-native customer email (order confirmation, refund
  // confirmation) with no way to suppress the native side — see
  // DECISIONS.md, 2026-08-17. Off by default even when sendingEnabled is
  // on; shipping-update, abandoned-cart, and review-request aren't gated
  // by this flag because they don't have that duplication problem.
  sendReceiptEmails Boolean  @default(false)
  language       String   @default("en")
  // One of EMAIL_TONES' codes (email-engine/types.ts). Defaults to the
  // tone every shop had before this field existed — "warm-plain" is the
  // Voice rule design-system-prompt.ts always used, so an un-migrated
  // shop's generated emails don't change until it actively picks another
  // tone in onboarding or the flow header.
  tone           String   @default("warm-plain")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// A merchant's choice of real (non-AI) template for one lifecycle email
// slot, plus its small set of editable values. Everything else about
// lifecycle emails today is stateless-per-request (see the in-memory
// previewCache in app._index.tsx) — this is the first thing that actually
// needs to survive a page reload.
model LifecycleTemplateChoice {
  id           String   @id @default(cuid())
  shop         String
  slotId       String
  mode         String   @default("ai") // "ai" | "template"
  logoUrl      String?
  primaryColor String?
  buttonText   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([shop, slotId])
}

model EmailJob {
  id                String    @id @default(cuid())
  webhookId         String    @unique
  shop              String
  topic             String
  payload           String
  status            String    @default("pending")
  attempts          Int       @default(0)
  availableAt       DateTime  @default(now())
  lastError         String?
  providerMessageId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sentAt            DateTime?

  @@index([status, availableAt])
}
