{% assign email_type = 'order_confirmation' %}
{% assign brand_ink = '#201e1d' %}
{% assign brand_paper = '#f3f2f2' %}
{% assign brand_cyan = '#00789e' %}
{% assign brand_magenta = '#d6006c' %}
{% assign brand_line = '#d9d7d4' %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  <style>
    @media only screen and (max-width: 620px) {
      .email-shell { width: 100% !important; }
      .email-pad { padding-left: 24px !important; padding-right: 24px !important; }
      .email-title { font-size: 34px !important; line-height: 38px !important; }
      .item-image { width: 68px !important; }
      .item-image img { width: 68px !important; height: 68px !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background:{{ brand_paper }};color:{{ brand_ink }};">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;background:{{ brand_paper }};">
    <tr>
      <td align="center" style="padding:28px 12px;">
        <table role="presentation" class="email-shell" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;background:#ffffff;">
          <tr>
            <td class="email-pad" style="padding:34px 48px 26px;border-top:6px solid {{ brand_ink }};">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td valign="middle">
                    {% if shop.email_logo_url %}
                      <img src="{{ shop.email_logo_url }}" alt="{{ shop.name }}" width="{{ shop.email_logo_width }}" height="60" style="display:block;max-width:180px;height:auto;border:0;">
                    {% else %}
                      <a href="{{ shop.url }}" style="font-family:'Source Serif 4',Georgia,serif;font-size:28px;line-height:32px;font-weight:600;letter-spacing:-0.03em;color:{{ brand_ink }};text-decoration:none;">{{ shop.name }}</a>
                    {% endif %}
                  </td>
                  <td align="right" valign="middle" style="font-family:Arial,Helvetica,sans-serif;font-size:10px;line-height:15px;letter-spacing:.16em;text-transform:uppercase;color:#6b6864;">
                    {% case email_type %}
                      {% when 'order_confirmation' %}Order confirmed
                      {% when 'return_refund' %}Return update
                      {% when 'abandoned_cart' %}Saved for you
                      {% else %}The latest
                    {% endcase %}
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr><td height="1" style="height:1px;background:{{ brand_line }};font-size:0;line-height:0;">&nbsp;</td></tr>

          {% case email_type %}
            {% when 'order_confirmation' %}
              <tr>
                <td class="email-pad" style="padding:52px 48px 18px;">
                  <div style="width:36px;height:4px;background:{{ brand_magenta }};font-size:0;line-height:0;">&nbsp;</div>
                  <h1 class="email-title" style="margin:22px 0 16px;font-family:'Source Serif 4',Georgia,serif;font-size:42px;line-height:46px;font-weight:600;letter-spacing:-0.025em;color:{{ brand_ink }};">Thank you{% if customer.first_name %}, {{ customer.first_name }}{% endif %}.</h1>
                  <p style="margin:0;font-family:'Source Serif 4',Georgia,serif;font-size:17px;line-height:27px;color:#4f4c49;">We have your order. We will send tracking as soon as it leaves us.</p>
                  <p style="margin:18px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:16px;letter-spacing:.14em;text-transform:uppercase;color:#6b6864;">{{ name }} &nbsp;·&nbsp; {{ created_at | date: '%d %B %Y' }}</p>
                </td>
              </tr>
              <tr>
                <td class="email-pad" style="padding:28px 48px 10px;">
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                    {% for line in line_items %}
                      <tr>
                        <td class="item-image" width="82" valign="top" style="width:82px;padding:0 18px 22px 0;">
                          {% if line.image %}<img src="{{ line.image | image_url: width: 164, height: 164 }}" alt="{{ line.title }}" width="82" height="82" style="display:block;width:82px;height:82px;object-fit:cover;border:0;background:{{ brand_paper }};">{% endif %}
                        </td>
                        <td valign="top" style="padding:2px 12px 22px 0;font-family:'Source Serif 4',Georgia,serif;font-size:16px;line-height:23px;color:{{ brand_ink }};">
                          {{ line.product.title | default: line.title }}
                          {% unless line.variant.title == 'Default Title' %}<div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#6b6864;padding-top:4px;">{{ line.variant.title }} · Qty {{ line.quantity }}</div>{% endunless %}
                        </td>
                        <td align="right" valign="top" style="padding:2px 0 22px;font-family:'Source Serif 4',Georgia,serif;font-size:16px;line-height:23px;color:{{ brand_ink }};white-space:nowrap;">{{ line.final_line_price | money }}</td>
                      </tr>
                    {% endfor %}
                    <tr><td colspan="3" height="1" style="height:1px;background:{{ brand_line }};font-size:0;line-height:0;">&nbsp;</td></tr>
                    <tr>
                      <td colspan="2" style="padding:18px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;text-transform:uppercase;letter-spacing:.12em;color:#6b6864;">Total</td>
                      <td align="right" style="padding:14px 0 0;font-family:'Source Serif 4',Georgia,serif;font-size:23px;line-height:28px;font-weight:600;color:{{ brand_ink }};">{{ total_price | money_with_currency }}</td>
                    </tr>
                  </table>
                </td>
              </tr>
              {% if shipping_address %}
                <tr>
                  <td class="email-pad" style="padding:34px 48px 0;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ brand_paper }};">
                      <tr><td style="padding:24px;font-family:'Source Serif 4',Georgia,serif;font-size:15px;line-height:23px;color:#4f4c49;"><strong style="color:{{ brand_ink }};">Shipping to</strong><br>{{ shipping_address | format_address }}</td></tr>
                    </table>
                  </td>
                </tr>
              {% endif %}
              <tr><td class="email-pad" align="left" style="padding:34px 48px 50px;"><a href="{{ order_status_url }}" style="display:inline-block;background:{{ brand_cyan }};color:#ffffff;text-decoration:none;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:16px;font-weight:bold;letter-spacing:.04em;padding:15px 22px;">View order</a></td></tr>

            {% when 'return_refund' %}
              <tr>
                <td class="email-pad" style="padding:52px 48px 20px;">
                  <div style="width:36px;height:4px;background:{{ brand_magenta }};font-size:0;line-height:0;">&nbsp;</div>
                  <h1 class="email-title" style="margin:22px 0 16px;font-family:'Source Serif 4',Georgia,serif;font-size:42px;line-height:46px;font-weight:600;letter-spacing:-0.025em;color:{{ brand_ink }};">Your refund is on its way.</h1>
                  <p style="margin:0;font-family:'Source Serif 4',Georgia,serif;font-size:17px;line-height:27px;color:#4f4c49;">We have processed {{ amount | money_with_currency }} for {{ name }}. Your bank can take several business days to post it.</p>
                </td>
              </tr>
              <tr>
                <td class="email-pad" style="padding:26px 48px 8px;">
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                    {% for refund_line in refund_line_items %}
                      {% assign line = refund_line.line_item %}
                      <tr>
                        <td style="padding:16px 0;border-top:1px solid {{ brand_line }};font-family:'Source Serif 4',Georgia,serif;font-size:16px;line-height:23px;color:{{ brand_ink }};">{{ line.title }}<div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#6b6864;">Qty {{ refund_line.quantity }}</div></td>
                        <td align="right" style="padding:16px 0;border-top:1px solid {{ brand_line }};font-family:'Source Serif 4',Georgia,serif;font-size:16px;line-height:23px;color:{{ brand_ink }};">{{ line.price | times: refund_line.quantity | money }}</td>
                      </tr>
                    {% endfor %}
                  </table>
                </td>
              </tr>
              <tr><td class="email-pad" style="padding:26px 48px 50px;">{% if customer_order_url %}<a href="{{ customer_order_url }}" style="display:inline-block;background:{{ brand_cyan }};color:#fff;text-decoration:none;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:16px;font-weight:bold;padding:15px 22px;">View return</a>{% elsif order_status_url %}<a href="{{ order_status_url }}" style="display:inline-block;background:{{ brand_cyan }};color:#fff;text-decoration:none;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:16px;font-weight:bold;padding:15px 22px;">View order</a>{% endif %}</td></tr>

            {% when 'abandoned_cart' %}
              {% assign recovery_url = abandoned_checkout.url | default: abandoned_visit.url %}
              <tr>
                <td class="email-pad" style="padding:52px 48px 20px;">
                  <div style="width:36px;height:4px;background:{{ brand_magenta }};font-size:0;line-height:0;">&nbsp;</div>
                  <h1 class="email-title" style="margin:22px 0 16px;font-family:'Source Serif 4',Georgia,serif;font-size:42px;line-height:46px;font-weight:600;letter-spacing:-0.025em;color:{{ brand_ink }};">Still thinking it over?</h1>
                  <p style="margin:0;font-family:'Source Serif 4',Georgia,serif;font-size:17px;line-height:27px;color:#4f4c49;">Your selection is saved. Pick up where you left off when you are ready.</p>
                </td>
              </tr>
              <tr>
                <td class="email-pad" style="padding:24px 48px 8px;">
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                    {% if abandoned_checkout %}
                      {% for line in abandoned_checkout.line_items %}
                        <tr><td width="70" style="padding:0 16px 18px 0;">{% if line.image_url %}<img src="{{ line.image_url }}" alt="{{ line.product_title }}" width="70" height="70" style="display:block;width:70px;height:70px;object-fit:cover;border:0;">{% endif %}</td><td style="padding:0 0 18px;font-family:'Source Serif 4',Georgia,serif;font-size:16px;line-height:23px;color:{{ brand_ink }};">{{ line.product_title }}<div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#6b6864;">{{ line.variant_title }} · Qty {{ line.quantity }}</div></td></tr>
                      {% endfor %}
                    {% else %}
                      {% for line in abandoned_visit.products_added_to_cart %}
                        <tr><td width="70" style="padding:0 16px 18px 0;">{% if line.image_url %}<img src="{{ line.image_url }}" alt="{{ line.title }}" width="70" height="70" style="display:block;width:70px;height:70px;object-fit:cover;border:0;">{% endif %}</td><td style="padding:0 0 18px;font-family:'Source Serif 4',Georgia,serif;font-size:16px;line-height:23px;color:{{ brand_ink }};">{{ line.title }}<div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#6b6864;">{{ line.variant_title }} · Qty {{ line.quantity }}</div></td></tr>
                      {% endfor %}
                    {% endif %}
                  </table>
                </td>
              </tr>
              <tr><td class="email-pad" style="padding:24px 48px 50px;"><a href="{{ recovery_url }}" style="display:inline-block;background:{{ brand_cyan }};color:#fff;text-decoration:none;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:16px;font-weight:bold;padding:15px 22px;">Return to checkout</a></td></tr>

            {% else %}
              <tr>
                <td class="email-pad" style="padding:58px 48px 22px;">
                  <p style="margin:0 0 16px;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:16px;letter-spacing:.16em;text-transform:uppercase;color:{{ brand_magenta }};">A note from {{ shop.name }}</p>
                  <h1 class="email-title" style="margin:0 0 20px;font-family:'Source Serif 4',Georgia,serif;font-size:46px;line-height:50px;font-weight:600;letter-spacing:-0.03em;color:{{ brand_ink }};">Something worth making room for.</h1>
                  <p style="margin:0;font-family:'Source Serif 4',Georgia,serif;font-size:18px;line-height:29px;color:#4f4c49;">Use this space for one clear campaign idea. Say what is new, why it matters, and what the reader can do next.</p>
                </td>
              </tr>
              <tr><td class="email-pad" style="padding:24px 48px 58px;"><a href="{{ shop.url }}" style="display:inline-block;background:{{ brand_cyan }};color:#fff;text-decoration:none;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:16px;font-weight:bold;padding:15px 22px;">Shop the edit</a></td></tr>
          {% endcase %}

          <tr><td height="1" style="height:1px;background:{{ brand_line }};font-size:0;line-height:0;">&nbsp;</td></tr>
          <tr>
            <td class="email-pad" style="padding:24px 48px 30px;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:18px;color:#6b6864;">
              <a href="{{ shop.url }}" style="color:{{ brand_cyan }};text-decoration:underline;">{{ shop.name }}</a>
              {% if email_type == 'abandoned_cart' or email_type == 'newsletter' %}<span style="padding:0 8px;">·</span><a href="{{ unsubscribe_url }}" style="color:{{ brand_cyan }};text-decoration:underline;">Unsubscribe</a>{{ open_tracking }}{% endif %}
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
