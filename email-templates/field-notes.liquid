{% assign email_type = 'order_confirmation' %}
{% assign brand_ink = '#201e1d' %}
{% assign brand_paper = '#f3f2f2' %}
{% assign brand_cyan = '#00789e' %}
{% assign brand_magenta = '#d6006c' %}
{% assign brand_line = '#d9d7d4' %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  <style>
    @media only screen and (max-width:620px) {
      .shell { width:100% !important; }
      .pad { padding-left:22px !important; padding-right:22px !important; }
      .title { font-size:32px !important; line-height:37px !important; }
      .note-number { width:34px !important; }
      .note-content { padding-left:14px !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background:#ebe7e1;color:{{ brand_ink }};">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;background:#ebe7e1;">
    <tr><td align="center" style="padding:30px 10px;">
      <table role="presentation" class="shell" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;background:{{ brand_paper }};">
        <tr>
          <td class="pad" style="padding:34px 44px 28px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
              <td>{% if shop.email_logo_url %}<img src="{{ shop.email_logo_url }}" alt="{{ shop.name }}" width="{{ shop.email_logo_width }}" height="60" style="display:block;max-width:170px;height:auto;border:0;">{% else %}<a href="{{ shop.url }}" style="font-family:'Source Serif 4',Georgia,serif;font-size:27px;line-height:31px;font-weight:600;letter-spacing:-.03em;color:{{ brand_ink }};text-decoration:none;">{{ shop.name }}</a>{% endif %}</td>
              <td align="right" style="font-family:'Source Serif 4',Georgia,serif;font-size:12px;line-height:18px;font-style:italic;color:#6b6864;">{% case email_type %}{% when 'order_confirmation' %}a note about your order{% when 'return_refund' %}a note about your return{% when 'abandoned_cart' %}a note about your cart{% else %}a note from us{% endcase %}</td>
            </tr></table>
          </td>
        </tr>

        {% case email_type %}
          {% when 'order_confirmation' %}
            <tr><td class="pad" style="padding:32px 44px 20px;border-top:1px solid {{ brand_line }};"><h1 class="title" style="margin:0 0 16px;font-family:'Source Serif 4',Georgia,serif;font-size:40px;line-height:45px;font-weight:600;letter-spacing:-.025em;color:{{ brand_ink }};">It is good to have you here{% if customer.first_name %}, {{ customer.first_name }}{% endif %}.</h1><p style="margin:0;font-family:'Source Serif 4',Georgia,serif;font-size:17px;line-height:27px;color:#56524f;">Your order is confirmed. Here is everything you need in one place.</p></td></tr>
            <tr><td class="pad" style="padding:24px 44px 8px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="note-number" width="44" valign="top"><span style="display:inline-block;width:30px;height:30px;border-radius:50%;background:{{ brand_magenta }};color:#ffffff;text-align:center;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:30px;font-weight:bold;">01</span></td><td class="note-content" valign="top" style="padding:2px 0 26px 18px;border-left:1px solid {{ brand_line }};"><p style="margin:0 0 12px;font-family:Arial,Helvetica,sans-serif;font-size:10px;line-height:15px;letter-spacing:.15em;text-transform:uppercase;color:#6b6864;">What you chose · {{ name }}</p>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">{% for line in line_items %}<tr><td width="60" valign="top" style="padding:0 14px 16px 0;">{% if line.image %}<img src="{{ line.image | image_url: width: 120, height: 120 }}" alt="{{ line.title }}" width="60" height="60" style="display:block;width:60px;height:60px;object-fit:cover;border:0;">{% endif %}</td><td valign="top" style="padding:2px 8px 16px 0;font-family:'Source Serif 4',Georgia,serif;font-size:15px;line-height:21px;color:{{ brand_ink }};">{{ line.product.title | default: line.title }}<div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:17px;color:#6b6864;">Qty {{ line.quantity }}{% unless line.variant.title == 'Default Title' %} · {{ line.variant.title }}{% endunless %}</div></td><td align="right" valign="top" style="padding:2px 0 16px;font-family:'Source Serif 4',Georgia,serif;font-size:15px;line-height:21px;color:{{ brand_ink }};white-space:nowrap;">{{ line.final_line_price | money }}</td></tr>{% endfor %}<tr><td colspan="2" style="padding:13px 0;border-top:1px solid {{ brand_line }};font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:16px;text-transform:uppercase;letter-spacing:.12em;color:#6b6864;">Total</td><td align="right" style="padding:10px 0;border-top:1px solid {{ brand_line }};font-family:'Source Serif 4',Georgia,serif;font-size:20px;line-height:26px;font-weight:600;color:{{ brand_ink }};">{{ total_price | money_with_currency }}</td></tr></table>
            </td></tr></table></td></tr>
            {% if shipping_address %}<tr><td class="pad" style="padding:0 44px 8px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="note-number" width="44" valign="top"><span style="display:inline-block;width:30px;height:30px;border-radius:50%;border:1px solid {{ brand_ink }};color:{{ brand_ink }};text-align:center;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:30px;font-weight:bold;">02</span></td><td class="note-content" valign="top" style="padding:2px 0 28px 18px;border-left:1px solid {{ brand_line }};"><p style="margin:0 0 8px;font-family:Arial,Helvetica,sans-serif;font-size:10px;line-height:15px;letter-spacing:.15em;text-transform:uppercase;color:#6b6864;">Where it is going</p><div style="font-family:'Source Serif 4',Georgia,serif;font-size:15px;line-height:23px;color:#56524f;">{{ shipping_address | format_address }}</div></td></tr></table></td></tr>{% endif %}
            <tr><td class="pad" style="padding:0 44px 46px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="note-number" width="44" valign="top"><span style="display:inline-block;width:30px;height:30px;border-radius:50%;border:1px solid {{ brand_ink }};color:{{ brand_ink }};text-align:center;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:30px;font-weight:bold;">03</span></td><td class="note-content" valign="top" style="padding:0 0 0 18px;"><a href="{{ order_status_url }}" style="display:inline-block;background:{{ brand_cyan }};color:#ffffff;text-decoration:none;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:16px;font-weight:bold;padding:14px 20px;">Follow your order</a></td></tr></table></td></tr>

          {% when 'return_refund' %}
            <tr><td class="pad" style="padding:32px 44px 20px;border-top:1px solid {{ brand_line }};"><h1 class="title" style="margin:0 0 16px;font-family:'Source Serif 4',Georgia,serif;font-size:40px;line-height:45px;font-weight:600;letter-spacing:-.025em;color:{{ brand_ink }};">The refund is complete on our side.</h1><p style="margin:0;font-family:'Source Serif 4',Georgia,serif;font-size:17px;line-height:27px;color:#56524f;">We sent {{ amount | money_with_currency }} back for {{ name }}. It may take several business days to appear.</p></td></tr>
            <tr><td class="pad" style="padding:24px 44px 8px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="note-number" width="44" valign="top"><span style="display:inline-block;width:30px;height:30px;border-radius:50%;background:{{ brand_magenta }};color:#ffffff;text-align:center;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:30px;font-weight:bold;">01</span></td><td class="note-content" style="padding:2px 0 28px 18px;border-left:1px solid {{ brand_line }};"><p style="margin:0 0 10px;font-family:Arial,Helvetica,sans-serif;font-size:10px;line-height:15px;letter-spacing:.15em;text-transform:uppercase;color:#6b6864;">Items included</p><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">{% for refund_line in refund_line_items %}{% assign line = refund_line.line_item %}<tr><td style="padding:12px 0;border-top:1px solid {{ brand_line }};font-family:'Source Serif 4',Georgia,serif;font-size:15px;line-height:21px;color:{{ brand_ink }};">{{ line.title }}<div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:17px;color:#6b6864;">Qty {{ refund_line.quantity }}</div></td><td align="right" style="padding:12px 0;border-top:1px solid {{ brand_line }};font-family:'Source Serif 4',Georgia,serif;font-size:15px;line-height:21px;color:{{ brand_ink }};">{{ line.price | times: refund_line.quantity | money }}</td></tr>{% endfor %}</table></td></tr></table></td></tr>
            <tr><td class="pad" style="padding:0 44px 46px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="note-number" width="44" valign="top"><span style="display:inline-block;width:30px;height:30px;border-radius:50%;border:1px solid {{ brand_ink }};color:{{ brand_ink }};text-align:center;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:30px;font-weight:bold;">02</span></td><td class="note-content" style="padding-left:18px;">{% if customer_order_url %}<a href="{{ customer_order_url }}" style="display:inline-block;background:{{ brand_cyan }};color:#ffffff;text-decoration:none;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:16px;font-weight:bold;padding:14px 20px;">View return</a>{% elsif order_status_url %}<a href="{{ order_status_url }}" style="display:inline-block;background:{{ brand_cyan }};color:#ffffff;text-decoration:none;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:16px;font-weight:bold;padding:14px 20px;">View order</a>{% endif %}</td></tr></table></td></tr>

          {% when 'abandoned_cart' %}
            {% assign recovery_url = abandoned_checkout.url | default: abandoned_visit.url %}
            {% assign remaining_item_count = abandoned_checkout.remaining_products_count | default: abandoned_visit.remaining_cart_products_count | default: 0 %}
            <tr><td class="pad" style="padding:32px 44px 20px;border-top:1px solid {{ brand_line }};"><h1 class="title" style="margin:0 0 16px;font-family:'Source Serif 4',Georgia,serif;font-size:40px;line-height:45px;font-weight:600;letter-spacing:-.025em;color:{{ brand_ink }};">A small reminder, if it helps.</h1><p style="margin:0;font-family:'Source Serif 4',Georgia,serif;font-size:17px;line-height:27px;color:#56524f;">You left a few things behind. We kept the path back to them.</p></td></tr>
            <tr><td class="pad" style="padding:24px 44px 8px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="note-number" width="44" valign="top"><span style="display:inline-block;width:30px;height:30px;border-radius:50%;background:{{ brand_magenta }};color:#ffffff;text-align:center;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:30px;font-weight:bold;">01</span></td><td class="note-content" style="padding:2px 0 26px 18px;border-left:1px solid {{ brand_line }};"><p style="margin:0 0 12px;font-family:Arial,Helvetica,sans-serif;font-size:10px;line-height:15px;letter-spacing:.15em;text-transform:uppercase;color:#6b6864;">Still in your cart</p><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">{% if abandoned_checkout %}{% for line in abandoned_checkout.line_items %}<tr><td width="58" style="padding:0 14px 14px 0;">{% if line.image_url %}<img src="{{ line.image_url | escape }}" alt="{{ line.product_title | escape }}" width="58" height="58" style="display:block;width:58px;height:58px;object-fit:cover;border:0;">{% endif %}</td><td style="padding:2px 0 14px;font-family:'Source Serif 4',Georgia,serif;font-size:15px;line-height:21px;color:{{ brand_ink }};">{{ line.product_title }}<div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:17px;color:#6b6864;">{% if line.variant_title != blank %}{{ line.variant_title }} · {% endif %}Qty {{ line.quantity }}</div></td></tr>{% endfor %}{% else %}{% for line in abandoned_visit.products_added_to_cart %}<tr><td width="58" style="padding:0 14px 14px 0;">{% if line.image_url %}<img src="{{ line.image_url | escape }}" alt="{{ line.title | escape }}" width="58" height="58" style="display:block;width:58px;height:58px;object-fit:cover;border:0;">{% endif %}</td><td style="padding:2px 0 14px;font-family:'Source Serif 4',Georgia,serif;font-size:15px;line-height:21px;color:{{ brand_ink }};">{{ line.title }}<div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:17px;color:#6b6864;">{% if line.variant_title != blank %}{{ line.variant_title }} · {% endif %}Qty {{ line.quantity }}</div></td></tr>{% endfor %}{% endif %}{% if remaining_item_count > 0 %}<tr><td colspan="2" style="padding:0 0 14px;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:17px;color:#6b6864;">+{{ remaining_item_count }} more {% if remaining_item_count == 1 %}item{% else %}items{% endif %}</td></tr>{% endif %}</table></td></tr></table></td></tr>
            {% if recovery_url != blank %}<tr><td class="pad" style="padding:0 44px 46px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="note-number" width="44" valign="top"><span style="display:inline-block;width:30px;height:30px;border-radius:50%;border:1px solid {{ brand_ink }};color:{{ brand_ink }};text-align:center;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:30px;font-weight:bold;">02</span></td><td class="note-content" style="padding-left:18px;"><a href="{{ recovery_url | escape }}" style="display:inline-block;background:{{ brand_cyan }};color:#ffffff;text-decoration:none;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:16px;font-weight:bold;padding:14px 20px;">Return to your cart</a></td></tr></table></td></tr>{% endif %}

          {% else %}
            <tr><td class="pad" style="padding:38px 44px 18px;border-top:1px solid {{ brand_line }};"><span style="display:inline-block;width:34px;height:34px;border-radius:50%;background:{{ brand_magenta }};color:#ffffff;text-align:center;font-family:Arial,Helvetica,sans-serif;font-size:10px;line-height:34px;font-weight:bold;">NEW</span><h1 class="title" style="margin:22px 0 16px;font-family:'Source Serif 4',Georgia,serif;font-size:42px;line-height:47px;font-weight:600;letter-spacing:-.025em;color:{{ brand_ink }};">A considered update from {{ shop.name }}.</h1><p style="margin:0;font-family:'Source Serif 4',Georgia,serif;font-size:17px;line-height:28px;color:#56524f;">Write this like a useful note: one idea, a little context, and no pressure. Let the product earn the click.</p></td></tr>
            <tr><td class="pad" style="padding:20px 44px 50px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td width="44" valign="top"><span style="display:inline-block;width:30px;height:30px;border-radius:50%;border:1px solid {{ brand_ink }};color:{{ brand_ink }};text-align:center;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:30px;font-weight:bold;">01</span></td><td style="padding-left:18px;"><a href="{{ shop.url }}" style="display:inline-block;background:{{ brand_cyan }};color:#ffffff;text-decoration:none;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:16px;font-weight:bold;padding:14px 20px;">Read the story</a></td></tr></table></td></tr>
        {% endcase %}

        <tr><td class="pad" style="padding:22px 44px 28px;border-top:1px solid {{ brand_line }};font-family:'Source Serif 4',Georgia,serif;font-size:12px;line-height:19px;font-style:italic;color:#6b6864;"><a href="{{ shop.url }}" style="color:{{ brand_cyan }};text-decoration:underline;font-style:normal;">{{ shop.name }}</a>{% if email_type == 'abandoned_cart' or email_type == 'newsletter' %}<span style="padding:0 7px;">·</span><a href="{{ unsubscribe_url }}" style="color:{{ brand_cyan }};text-decoration:underline;font-style:normal;">Unsubscribe</a>{{ open_tracking }}{% endif %}</td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
